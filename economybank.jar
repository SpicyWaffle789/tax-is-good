package com.example.economybank;

import net.milkbowl.vault.economy.Economy;
import org.bukkit.Bukkit;
import org.bukkit.ChatColor;
import org.bukkit.OfflinePlayer;
import org.bukkit.Statistic;
import org.bukkit.command.Command;
import org.bukkit.command.CommandExecutor;
import org.bukkit.command.CommandSender;
import org.bukkit.configuration.ConfigurationSection;
import org.bukkit.configuration.file.FileConfiguration;
import org.bukkit.configuration.file.YamlConfiguration;
import org.bukkit.entity.Player;
import org.bukkit.plugin.RegisteredServiceProvider;
import org.bukkit.plugin.java.JavaPlugin;
import org.bukkit.scheduler.BukkitRunnable;

import java.io.File;
import java.io.IOException;
import java.util.*;

public class EconomyBank extends JavaPlugin implements CommandExecutor {

    private static Economy econ = null;
    private final Map<UUID, Long> lastInterestPlaytime = new HashMap<>();

    private File dataFile;
    private FileConfiguration dataConfig;

    private double baselineWealth;
    private double baseInterestRate;
    private double minInterestRate;
    private double maxInterestRate;
    private long requiredPlaytimeTicks;
    private long economyUpdateTicks;

    private double currentAverageWealth = 10000.0;
    private double currentEffectiveInterestRate = 0.02;

    @Override
    public void onEnable() {
        if (!setupEconomy()) {
            getLogger().severe("Vault dependency missing or no Economy provider found! Disabling plugin.");
            getServer().getPluginManager().disablePlugin(this);
            return;
        }

        saveDefaultConfig();
        loadConfigValues();

        setupDataFile();
        loadPlaytimeData();

        Objects.requireNonNull(getCommand("interest")).setExecutor(this);

        if (Bukkit.getPluginManager().isPluginEnabled("EconomyShopGUI") || 
            Bukkit.getPluginManager().isPluginEnabled("EconomyShopGUI-Premium")) {
            getLogger().info("Successfully connected to EconomyShopGUI.");
        }

        startPlaytimeInterestTask();
        startEconomyAdjustmentTask();
    }

    @Override
    public void onDisable() {
        savePlaytimeData();
    }

    private boolean setupEconomy() {
        if (getServer().getPluginManager().getPlugin("Vault") == null) return false;
        RegisteredServiceProvider<Economy> rsp = getServer().getServicesManager().getRegistration(Economy.class);
        if (rsp == null) return false;
        econ = rsp.getProvider();
        return econ != null;
    }

    private void loadConfigValues() {
        FileConfiguration config = getConfig();
        this.baselineWealth = config.getDouble("baseline-wealth", 10000.0);
        this.baseInterestRate = config.getDouble("base-interest-rate", 0.02);
        this.minInterestRate = config.getDouble("min-interest-rate", 0.005);
        this.maxInterestRate = config.getDouble("max-interest-rate", 0.05);

        long playtimeHours = config.getLong("required-playtime-hours", 24);
        this.requiredPlaytimeTicks = playtimeHours * 3600L * 20L;

        long updateHours = config.getLong("economy-update-interval-hours", 24);
        this.economyUpdateTicks = updateHours * 3600L * 20L;
    }

    // --- Data Storage ---
    private void setupDataFile() {
        dataFile = new File(getDataFolder(), "playtime_data.yml");
        if (!dataFile.exists()) {
            try {
                getDataFolder().mkdirs();
                dataFile.createNewFile();
            } catch (IOException e) {
                getLogger().severe("Could not create playtime_data.yml!");
            }
        }
        dataConfig = YamlConfiguration.loadConfiguration(dataFile);
    }

    private void loadPlaytimeData() {
        if (dataConfig.contains("players")) {
            for (String uuidStr : Objects.requireNonNull(dataConfig.getConfigurationSection("players")).getKeys(false)) {
                UUID uuid = UUID.fromString(uuidStr);
                lastInterestPlaytime.put(uuid, dataConfig.getLong("players." + uuidStr + ".last-playtime", 0L));
            }
        }
    }

    private void savePlaytimeData() {
        for (Map.Entry<UUID, Long> entry : lastInterestPlaytime.entrySet()) {
            dataConfig.set("players." + entry.getKey().toString() + ".last-playtime", entry.getValue());
        }
        try {
            dataConfig.save(dataFile);
        } catch (IOException e) {
            getLogger().severe("Could not save player playtime data to playtime_data.yml!");
        }
    }

    // --- Outlier Removal & Wealth Calculation ---
    public double calculateTrimmedAverageWealth() {
        List<Double> balances = new ArrayList<>();
        for (OfflinePlayer player : Bukkit.getOfflinePlayers()) {
            double bal = econ.getBalance(player);
            if (bal >= 0) {
                balances.add(bal);
            }
        }

        if (balances.isEmpty()) return baselineWealth;
        if (balances.size() < 4) {
            double sum = 0;
            for (double b : balances) sum += b;
            return sum / balances.size();
        }

        Collections.sort(balances);

        // Calculate IQR bounds
        double q1 = getPercentile(balances, 25);
        double q3 = getPercentile(balances, 75);
        double iqr = q3 - q1;
        double lowerBound = q1 - (1.5 * iqr);
        double upperBound = q3 + (1.5 * iqr);

        // Filter out outliers
        List<Double> filtered = new ArrayList<>();
        for (double b : balances) {
            if (b >= lowerBound && b <= upperBound) {
                filtered.add(b);
            }
        }

        if (filtered.isEmpty()) return baselineWealth;

        double sum = 0;
        for (double val : filtered) sum += val;
        return sum / filtered.size();
    }

    private double getPercentile(List<Double> sortedList, double percentile) {
        int index = (int) Math.ceil((percentile / 100.0) * sortedList.size()) - 1;
        index = Math.max(0, Math.min(index, sortedList.size() - 1));
        return sortedList.get(index);
    }

    // --- Scheduled Economy & Inflation Tasks ---
    private void startEconomyAdjustmentTask() {
        new BukkitRunnable() {
            @Override
            public void run() {
                recalculateEconomy();
            }
        }.runTaskTimer(this, 100L, economyUpdateTicks);
    }

    public void recalculateEconomy() {
        this.currentAverageWealth = calculateTrimmedAverageWealth();

        // Calculate wealth multiplier relative to baseline (e.g., $15,000 / $10,000 = 1.5x)
        double wealthRatio = Math.max(0.1, currentAverageWealth / baselineWealth);

        // Higher average wealth reduces interest to curb inflation
        double targetInterest = baseInterestRate / wealthRatio;
        this.currentEffectiveInterestRate = Math.max(minInterestRate, Math.min(maxInterestRate, targetInterest));

        getLogger().info(String.format("[EconomyEngine] Trimmed Avg Wealth: $%.2f | Wealth Ratio: %.2fx | New Interest Rate: %.2f%%",
                currentAverageWealth, wealthRatio, currentEffectiveInterestRate * 100.0));

        updateShopPrices(wealthRatio);
    }

    private void updateShopPrices(double wealthRatio) {
        File shopsFolder = new File(getDataFolder().getParentFile(), "EconomyShopGUI/shops");
        if (!shopsFolder.exists() || !shopsFolder.isDirectory()) return;

        File[] shopFiles = shopsFolder.listFiles((dir, name) -> name.endsWith(".yml"));
        if (shopFiles == null || shopFiles.length == 0) return;

        int updatedCount = 0;

        for (File shopFile : shopFiles) {
            YamlConfiguration shopConfig = YamlConfiguration.loadConfiguration(shopFile);
            ConfigurationSection itemsSection = shopConfig.getConfigurationSection("items");
            if (itemsSection == null) continue;

            for (String itemKey : itemsSection.getKeys(false)) {
                String path = "items." + itemKey;

                // Scale buy/sell prices according to the wealth multiplier ratio
                if (shopConfig.contains(path + ".base-buy")) {
                    double baseBuy = shopConfig.getDouble(path + ".base-buy");
                    shopConfig.set(path + ".buy", Math.round((baseBuy * wealthRatio) * 100.0) / 100.0);
                    updatedCount++;
                } else if (shopConfig.contains(path + ".buy")) {
                    double currentBuy = shopConfig.getDouble(path + ".buy");
                    shopConfig.set(path + ".base-buy", currentBuy); // Save initial base buy price
                    shopConfig.set(path + ".buy", Math.round((currentBuy * wealthRatio) * 100.0) / 100.0);
                    updatedCount++;
                }

                if (shopConfig.contains(path + ".base-sell")) {
                    double baseSell = shopConfig.getDouble(path + ".base-sell");
                    shopConfig.set(path + ".sell", Math.round((baseSell * wealthRatio) * 100.0) / 100.0);
                    updatedCount++;
                } else if (shopConfig.contains(path + ".sell")) {
                    double currentSell = shopConfig.getDouble(path + ".sell");
                    shopConfig.set(path + ".base-sell", currentSell); // Save initial base sell price
                    shopConfig.set(path + ".sell", Math.round((currentSell * wealthRatio) * 100.0) / 100.0);
                    updatedCount++;
                }
            }

            try {
                shopConfig.save(shopFile);
            } catch (IOException e) {
                getLogger().severe("Could not save shop file: " + shopFile.getName());
            }
        }

        Bukkit.dispatchCommand(Bukkit.getConsoleSender(), "eshop reload");
        getLogger().info("[EconomyEngine] Adjusted " + updatedCount + " shop prices based on wealth ratio (" + String.format("%.2f", wealthRatio) + "x).");
    }

    // --- Playtime Interest Task ---
    private void startPlaytimeInterestTask() {
        new BukkitRunnable() {
            @Override
            public void run() {
                for (Player player : Bukkit.getOnlinePlayers()) {
                    UUID id = player.getUniqueId();
                    long currentPlaytime = player.getStatistic(Statistic.PLAY_ONE_MINUTE);

                    if (!lastInterestPlaytime.containsKey(id)) {
                        lastInterestPlaytime.put(id, currentPlaytime);
                        continue;
                    }

                    long lastPlaytime = lastInterestPlaytime.get(id);
                    if (currentPlaytime - lastPlaytime >= requiredPlaytimeTicks) {
                        double walletBalance = econ.getBalance(player);
                        if (walletBalance > 0) {
                            double interest = walletBalance * currentEffectiveInterestRate;
                            econ.depositPlayer(player, interest);
                            player.sendMessage(ChatColor.GREEN + "[Economy] Received $" + String.format("%.2f", interest) + 
                                    " (" + String.format("%.2f", currentEffectiveInterestRate * 100) + "% dynamic interest) for 24 hours of playtime!");
                        }
                        lastInterestPlaytime.put(id, currentPlaytime);
                        savePlaytimeData();
                    }
                }
            }
        }.runTaskTimer(this, 1200L, 1200L);
    }

    // --- Status Command ---
    @Override
    public boolean onCommand(CommandSender sender, Command command, String label, String[] args) {
        if (!(sender instanceof Player player)) {
            sender.sendMessage("Only players can check economy status.");
            return true;
        }

        long currentPlaytime = player.getStatistic(Statistic.PLAY_ONE_MINUTE);
        long lastPlaytime = lastInterestPlaytime.getOrDefault(player.getUniqueId(), currentPlaytime);
        long progressTicks = currentPlaytime - lastPlaytime;
        long remainingSeconds = Math.max(0, (requiredPlaytimeTicks - progressTicks) / 20);
        long hoursRemaining = remainingSeconds / 3600;
        long minsRemaining = (remainingSeconds % 3600) / 60;

        double walletBalance = econ.getBalance(player);
        double estimatedInterest = walletBalance * currentEffectiveInterestRate;

        player.sendMessage(ChatColor.GOLD + "=== Server Economy Status ===");
        player.sendMessage(ChatColor.GRAY + "Server Average Wealth: " + ChatColor.YELLOW + "$" + String.format("%.2f", currentAverageWealth));
        player.sendMessage(ChatColor.GRAY + "Current Dynamic Interest: " + ChatColor.GREEN + String.format("%.2f", currentEffectiveInterestRate * 100) + "%");
        player.sendMessage(ChatColor.GRAY + "Your Balance: " + ChatColor.YELLOW + "$" + String.format("%.2f", walletBalance));
        player.sendMessage(ChatColor.GRAY + "Est. Next Payout: " + ChatColor.GREEN + "$" + String.format("%.2f", estimatedInterest));
        player.sendMessage(ChatColor.GRAY + "Playtime Remaining: " + ChatColor.AQUA + hoursRemaining + "h " + minsRemaining + "m");

        return true;
    }
}
